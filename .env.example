# Copy this file to .env before running Docker Compose.
# Do not commit real secrets.

POSTGRES_USER=telecom_user
POSTGRES_PASSWORD=telecom_password
POSTGRES_DB=telecom_analytics
POSTGRES_PORT=5433

SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8081
SPARK_WORKER_WEBUI_PORT=8082
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2

# Databricks upload settings.
# Keep real tokens only in .env. Never commit them.
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_REMOTE_ROOT=dbfs:/Volumes/<catalog>/<schema>/<volume>/telecom-customer-usage-pipeline/delta

# Optional: only needed when registering uploaded Delta folders as SQL tables.
DATABRICKS_REGISTER_TABLES=false
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_SQL_CATALOG=
DATABRICKS_SQL_SCHEMA=telecom_customer_usage
